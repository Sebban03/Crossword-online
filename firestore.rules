rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jedna gra = jeden dokument games/KOD
    match /games/{code} {
      allow read: if code.size() == 4;
      allow create: if code.size() == 4
        && request.resource.data.keys().hasAll(['lvl', 'p', 'st', 'fill', 'own', 'sc'])
        && request.resource.data.keys().size() < 20;
      allow update: if request.resource.data.lvl == resource.data.lvl
        && request.resource.data.keys().size() < 20;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
